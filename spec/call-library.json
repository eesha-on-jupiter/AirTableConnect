  {
    "endpoint_id": "create_field",
    "component": "CreateFieldComponent",
    "method": "POST",
    "url_template": "/v0/meta/bases/{baseId}/tables/{tableId}/fields",
    "base_url": "https://api.airtable.com",
    "auth_in": "header",
    "path_params": [
      {
        "name": "baseId",
        "type": "string"
      },
      {
        "name": "tableId",
        "type": "string"
      }
    ],
    "query_params": [],
    "headers": {
      "Authorization": "Bearer {token}",
      "Content-Type": "application/json"
    },
    "body_schema": {
      "name": "string",
      "type": "string, one of Airtable's field type enum",
      "description": "string (optional)",
      "options": "object, shape depends on type \u2014 e.g. singleSelect/multipleSelects need { choices: [{name,color?}] }; number needs { precision }; percent/currency similar"
    },
    "response_schema": {
      "id": "string (fldXXXX)",
      "name": "string",
      "type": "string",
      "options": "object (echoes/normalizes input options)"
    },
    "example_request": {
      "name": "Status",
      "type": "singleSelect",
      "options": {
        "choices": [
          {
            "name": "Todo"
          },
          {
            "name": "Done"
          }
        ]
      }
    },
    "example_response": {
      "id": "fldsxpc2hwPjTGRt7",
      "name": "Status",
      "type": "singleSelect",
      "options": {
        "choices": [
          {
            "id": "selJDW9aG2XuNrRRC",
            "name": "Todo",
            "color": "greenBright"
          }
        ]
      }
    },
    "notes": "Manually sourced (docs page JS-rendered). options shape varies per field type \u2014 FieldBuilders.cs only assembles options for the curated FieldTypePreset subset in plugin-spec.json (skips formula/rollup/lookup/linkedRecord per skip_for_v1 rationale), so this is a controlled variant surface, not true ambiguity.",
    "status": "EXTRACTED"
  },
