  {
    "endpoint_id": "create_records",
    "component": "CreateRecordsComponent",
    "method": "POST",
    "url_template": "/v0/{baseId}/{tableIdOrName}",
    "base_url": "https://api.airtable.com",
    "auth_in": "header",
    "path_params": [
