    "query_params": [],
    "headers": {
      "Authorization": "Bearer {token}",
      "Content-Type": "application/json"
    },
    "body_schema": {
      "records": "array, required, max 10 per call \u2014 [{ fields: object }]",
      "typecast": "bool (optional), auto-converts loosely-typed values"
    },
    "response_schema": {
      "records": [
        {
          "id": "string (recXXXX)",
          "createdTime": "string (ISO 8601)",
          "fields": "object"
        }
      ]
    },
    "example_request": {
      "records": [
        {
          "fields": {
            "Name": "Example"
          }
        }
      ],
      "typecast": false
    },
    "example_response": {
      "records": [
        {
          "id": "recFdmveWO6ka1cSp",
          "createdTime": "2024-01-01T00:00:00.000Z",
          "fields": {
            "Name": "Example"
          }
        }
      ]
    },
    "notes": "Manually sourced (docs page JS-rendered). Airtable caps at 10 records/call; CreateRecordsComponent auto-chunks larger Record JSON lists into sequential requests of 10 (Batch Processor AEC feature), concatenating Record IDs/Status/Response across chunks.",
