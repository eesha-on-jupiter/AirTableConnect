      }
    ],
    "headers": {
      "Authorization": "Bearer {token}"
    },
    "body_schema": null,
    "response_schema": {
      "records": [
        {
          "id": "string (recXXXX)",
          "createdTime": "string (ISO 8601)",
          "fields": "object"
        }
      ],
      "offset": "string (present only if more pages remain)"
    },
    "example_request": {},
    "example_response": {
      "records": [
        {
          "id": "recFdmveWO6ka1cSp",
          "createdTime": "2024-01-01T00:00:00.000Z",
          "fields": {
            "Name": "Example"
          }
        }
      ]
    },
    "notes": "Manually sourced (docs page JS-rendered). ListRecordsComponent auto-loops offset internally (Batch Processor AEC feature) until offset is absent or Max Records reached, rather than surfacing one page.",
