  {
    "endpoint_id": "update_records",
    "component": "UpdateRecordsComponent",
    "method": "PATCH",
    "url_template": "/v0/{baseId}/{tableIdOrName}",
    "base_url": "https://api.airtable.com",
    "auth_in": "header",
    "path_params": [
      {
        "name": "baseId",
        "type": "string"
      },
      {
        "name": "tableIdOrName",
        "type": "string"
      }
    ],
    "query_params": [],
    "headers": {
      "Authorization": "Bearer {token}",
      "Content-Type": "application/json"
    },
    "body_schema": {
      "records": "array, required, max 10 per call — [{ id: string, fields: object }] (id omitted per-record when performUpsert is used and no match)",
      "typecast": "bool (optional)",
      "performUpsert": "object (optional) — { fieldsToMergeOn: string[] } enables upsert-by-key"
    },
    "response_schema": {
      "records": [
        {
          "id": "string (recXXXX)",
          "createdTime": "string",
          "fields": "object"
        }
      ],
      "createdRecords": "string[] (record IDs newly created, upsert only)",
      "updatedRecords": "string[] (record IDs matched and updated, upsert only)"
    },
    "example_request": {
      "performUpsert": {
        "fieldsToMergeOn": [
          "SKU"
        ]
      },
      "records": [
        {
          "fields": {
            "SKU": "A1",
            "Qty": 5
          }
        }
      ]
    },
    "example_response": {
      "records": [
        {
          "id": "recFdmveWO6ka1cSp",
          "createdTime": "2024-01-01T00:00:00.000Z",
          "fields": {
            "SKU": "A1",
            "Qty": 5
          }
        }
      ],
      "createdRecords": [
        "recFdmveWO6ka1cSp"
      ],
      "updatedRecords": []
    },
    "notes": "Manually sourced (docs page JS-rendered). PATCH (not PUT/replace_records, which is skipped for v1 as destructive). Same 10-record chunking as create_records (Batch Processor). Upsert path used by 'Sync Generative Model to Airtable by Key' workflow via the Upsert + Fields To Merge On inputs.",
